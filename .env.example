# --- Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanad_youth"

# --- JWT (استخدمي قيم عشوائية طويلة ومختلفة عن بعض)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"

# --- Redis (BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# --- App
PORT=3000

# --- Throttling (طلبات بالدقيقة لكل IP)
THROTTLE_LIMIT=100          # عام
LOGIN_THROTTLE_LIMIT=5      # login (ارفعيها مؤقتًا لـ 1000 وقت تشغيل test/last-seat.mjs)
REGISTER_THROTTLE_LIMIT=10
REFRESH_THROTTLE_LIMIT=20

# --- Seed
SEED_ON_BOOT=true
SEED_ADMIN_PASSWORD="Admin@12345"
